{
  "name": "izumo-engiri-step7",
  "description": "出雲縁切り LINEステップ配信（Day0〜7）。分岐はDay0/Day2/Day3のみレベル別、他は共通。販売は全てnote（1,000円レベル別レポート→4,980円カウンセリング→49,800円講座）",
  "timezone": "Asia/Tokyo",
  "tags": [
    {
      "key": "level_a",
      "label": "レベルA：今すぐ離れたい相手がいる（緊急度高）"
    },
    {
      "key": "level_b",
      "label": "レベルB：離れたいが迷いが強い"
    },
    {
      "key": "level_c",
      "label": "レベルC：モヤモヤはあるが相手が特定できていない"
    },
    {
      "key": "level_d",
      "label": "レベルD：今は平気。予防・興味層"
    },
    {
      "key": "step_active",
      "label": "ステップ配信中"
    },
    {
      "key": "step_done",
      "label": "ステップ配信完了（週1ナーチャリングへ）"
    },
    {
      "key": "bought_report",
      "label": "診断レポート購入済み（1,000円）"
    },
    {
      "key": "bought_counseling",
      "label": "カウンセリング申込済み（4,980円）"
    },
    {
      "key": "bought_course",
      "label": "講座購入済み（49,800円）"
    },
    {
      "key": "kantei_level_a",
      "label": "AI鑑定 レベルA（合言葉受付）"
    },
    {
      "key": "kantei_level_b",
      "label": "AI鑑定 レベルB（合言葉受付）"
    },
    {
      "key": "kantei_level_c",
      "label": "AI鑑定 レベルC（合言葉受付）"
    },
    {
      "key": "kantei_level_d",
      "label": "AI鑑定 レベルD（合言葉受付）"
    },
    {
      "key": "kantei_waiting",
      "label": "AI鑑定 状況入力待ち"
    },
    {
      "key": "kantei_done",
      "label": "AI鑑定 送信済み"
    },
    {
      "key": "kantei_followup_ok",
      "label": "AI鑑定 追加質問 残り1回"
    },
    {
      "key": "kantei_safety_hold",
      "label": "AI鑑定 危険ワード検知・運営確認"
    },
    {
      "key": "course_member",
      "label": "講座受講生（LINEで『講座』送信）"
    },
    {
      "key": "nurture_active",
      "label": "週1ナーチャリング配信の対象"
    }
  ],
  "keyword_rules": [
    {
      "id": "kw-level-a",
      "trigger": {
        "type": "message_exact",
        "keywords": [
          "A",
          "a",
          "Ａ",
          "ａ"
        ]
      },
      "actions": [
        {
          "type": "add_tag",
          "tag": "level_a"
        },
        {
          "type": "add_tag",
          "tag": "step_active"
        },
        {
          "type": "send_message",
          "template": "messages/day0-common.md"
        },
        {
          "type": "send_message",
          "template": "messages/day0-level-a.md"
        },
        {
          "type": "start_scenario",
          "scenario": "izumo-engiri-step7"
        }
      ],
      "once_per_user": true
    },
    {
      "id": "kw-level-b",
      "trigger": {
        "type": "message_exact",
        "keywords": [
          "B",
          "b",
          "Ｂ",
          "ｂ"
        ]
      },
      "actions": [
        {
          "type": "add_tag",
          "tag": "level_b"
        },
        {
          "type": "add_tag",
          "tag": "step_active"
        },
        {
          "type": "send_message",
          "template": "messages/day0-common.md"
        },
        {
          "type": "send_message",
          "template": "messages/day0-level-b.md"
        },
        {
          "type": "start_scenario",
          "scenario": "izumo-engiri-step7"
        }
      ],
      "once_per_user": true
    },
    {
      "id": "kw-level-c",
      "trigger": {
        "type": "message_exact",
        "keywords": [
          "C",
          "c",
          "Ｃ",
          "ｃ"
        ]
      },
      "actions": [
        {
          "type": "add_tag",
          "tag": "level_c"
        },
        {
          "type": "add_tag",
          "tag": "step_active"
        },
        {
          "type": "send_message",
          "template": "messages/day0-common.md"
        },
        {
          "type": "send_message",
          "template": "messages/day0-level-c.md"
        },
        {
          "type": "start_scenario",
          "scenario": "izumo-engiri-step7"
        }
      ],
      "once_per_user": true
    },
    {
      "id": "kw-level-d",
      "trigger": {
        "type": "message_exact",
        "keywords": [
          "D",
          "d",
          "Ｄ",
          "ｄ"
        ]
      },
      "actions": [
        {
          "type": "add_tag",
          "tag": "level_d"
        },
        {
          "type": "add_tag",
          "tag": "step_active"
        },
        {
          "type": "send_message",
          "template": "messages/day0-common.md"
        },
        {
          "type": "send_message",
          "template": "messages/day0-level-d.md"
        },
        {
          "type": "start_scenario",
          "scenario": "izumo-engiri-step7"
        }
      ],
      "once_per_user": true
    },
    {
      "id": "kw-kantei-passcode",
      "trigger": {
        "type": "message_exact",
        "keywords": [
          "縁A-717",
          "縁B-323",
          "縁C-505",
          "縁D-141"
        ],
        "normalize": "trim+fullwidth+upper+strip(-_space)",
        "note": "縁A717 / 縁ａ-717 / 縁 A 717 なども同一とみなす"
      },
      "actions": [
        {
          "type": "custom",
          "handler": "ai_kantei.on_passcode",
          "note": "レベル判定→bought_report/kantei_level_x/kantei_waiting 付与→intake送信。kantei_done 済みなら再受付しない"
        }
      ]
    },
    {
      "id": "kw-kantei-input",
      "trigger": {
        "type": "free_text_if_tag",
        "tag": "kantei_waiting"
      },
      "actions": [
        {
          "type": "custom",
          "handler": "ai_kantei.on_input",
          "note": "危険ワード→safety / 20文字未満→short / それ以外→Claude API で生成し push"
        }
      ]
    },
    {
      "id": "kw-kantei-followup",
      "trigger": {
        "type": "free_text_if_tag",
        "tag": "kantei_followup_ok"
      },
      "actions": [
        {
          "type": "custom",
          "handler": "ai_kantei.on_followup",
          "note": "履歴付きで1回だけ生成。以後は followup_end を返す"
        }
      ]
    },
    {
      "id": "kw-course-member",
      "trigger": {
        "type": "message_exact",
        "keywords": [
          "講座"
        ]
      },
      "actions": [
        {
          "type": "add_tag",
          "tag": "course_member"
        },
        {
          "type": "add_tag",
          "tag": "bought_course"
        },
        {
          "type": "send_message",
          "text": "受講生として登録した。週1相談会の案内は、このLINEに届く。質問はいつでもここに送ってほしい。"
        }
      ]
    },
    {
      "id": "kw-counseling-applied",
      "trigger": {
        "type": "message_exact",
        "keywords": [
          "申込みました",
          "申し込みました"
        ]
      },
      "actions": [
        {
          "type": "add_tag",
          "tag": "bought_counseling"
        },
        {
          "type": "send_message",
          "text": "確認した。予約した日時の前日までに、Zoomのリンクをここに送る。当日までに①関係 ②いつから ③一番困っている場面、をメモしておいてほしい。"
        }
      ]
    },
    {
      "id": "kw-kantei-rescue",
      "trigger": {
        "type": "message_contains",
        "keywords": [
          "鑑定",
          "合言葉",
          "パスワード",
          "あいことば"
        ],
        "except_if_tag": [
          "kantei_waiting",
          "kantei_followup_ok"
        ]
      },
      "actions": [
        {
          "type": "send_message",
          "text": "合言葉は、購入した note の記事の一番下にある。\n\n「ここから先は購入者のみ」の下まで\nスクロールしてほしい。\n一番下に「縁◯-◯◯◯」という形で書いてある。\n\n見つからなければ、購入したときの\nnoteのアカウントでログインし直すと表示される。"
        }
      ]
    }
  ],
  "variables": {
    "report_url_a": "https://note.com/USER/n/REPORT_A",
    "report_url_b": "https://note.com/USER/n/REPORT_B",
    "report_url_c": "https://note.com/USER/n/REPORT_C",
    "report_url_d": "https://note.com/USER/n/REPORT_D",
    "counseling_url": "https://note.com/USER/n/COUNSELING",
    "course_url": "https://note.com/USER/n/COURSE",
    "_note": "noteの記事URLが決まったら差し替える。配信時は L Harness のトラッキングリンク経由にする",
    "booking_url": "https://calendar.app.google/XXXX",
    "course_line_url": "https://lin.ee/y8Mrezf8"
  },
  "steps": [
    {
      "day": 1,
      "send_time": "20:00",
      "title": "縁を切る＝悪ではない",
      "template": "messages/day1-common.md"
    },
    {
      "day": 2,
      "send_time": "20:00",
      "title": "最初の一歩（レベル別）",
      "branches": [
        {
          "if_tag": "level_a",
          "template": "messages/day2-level-a.md"
        },
        {
          "if_tag": "level_b",
          "template": "messages/day2-level-b.md"
        },
        {
          "if_tag": "level_c",
          "template": "messages/day2-level-c.md"
        },
        {
          "if_tag": "level_d",
          "template": "messages/day2-level-d.md"
        }
      ]
    },
    {
      "day": 3,
      "send_time": "20:00",
      "title": "低額オファー：レベル別診断レポート 1,000円（note有料記事×4）",
      "kpi": "開封率＋クリック率を最初のKPIにする",
      "branches": [
        {
          "if_tag": "level_a",
          "template": "messages/day3-offer-report.md",
          "variables": {
            "report_url": "{{report_url_a}}"
          }
        },
        {
          "if_tag": "level_b",
          "template": "messages/day3-offer-report.md",
          "variables": {
            "report_url": "{{report_url_b}}"
          }
        },
        {
          "if_tag": "level_c",
          "template": "messages/day3-offer-report.md",
          "variables": {
            "report_url": "{{report_url_c}}"
          }
        },
        {
          "if_tag": "level_d",
          "template": "messages/day3-offer-report.md",
          "variables": {
            "report_url": "{{report_url_d}}"
          }
        }
      ],
      "follow_up_message": {
        "template": "messages/buttons/day3-report-button.json",
        "type": "flex"
      },
      "note": "本文の直後にボタン付きメッセージをもう1通送る（URLはボタンにのみ入れる）"
    },
    {
      "day": 4,
      "send_time": "20:00",
      "title": "よくある相談パターン",
      "template": "messages/day4-common.md"
    },
    {
      "day": 5,
      "send_time": "20:00",
      "title": "中額オファー：カウンセリング 4,980円（note有料記事＝申込チケット）",
      "template": "messages/day5-offer-counseling.md",
      "follow_up_message": {
        "template": "messages/buttons/day5-counseling-button.json",
        "type": "flex"
      },
      "note": "本文の直後にボタン付きメッセージをもう1通送る（URLはボタンにのみ入れる）"
    },
    {
      "day": 6,
      "send_time": "20:00",
      "title": "講座の中身公開",
      "template": "messages/day6-course-preview.md"
    },
    {
      "day": 7,
      "send_time": "20:00",
      "title": "講座オファー 49,800円（note有料記事、プレミアム必須）",
      "template": "messages/day7-offer-course.md",
      "kpi": "開封率＋クリック率を最初のKPIにする",
      "after_actions": [
        {
          "type": "remove_tag",
          "tag": "step_active"
        },
        {
          "type": "add_tag",
          "tag": "step_done"
        }
      ],
      "follow_up_message": {
        "template": "messages/buttons/day7-course-button.json",
        "type": "flex"
      },
      "note": "本文の直後にボタン付きメッセージをもう1通送る（URLはボタンにのみ入れる）"
    },
    {
      "day": 8,
      "send_time": "20:00",
      "title": "フォロー①よくある質問",
      "template": "messages/day8-followup.md",
      "audience": {
        "has_tag": "step_done",
        "not_tag": "bought_course"
      }
    },
    {
      "day": 9,
      "send_time": "20:00",
      "title": "フォロー②この講座で扱わないこと",
      "template": "messages/day9-followup.md",
      "audience": {
        "has_tag": "step_done",
        "not_tag": "bought_course"
      }
    },
    {
      "day": 10,
      "send_time": "20:00",
      "title": "フォロー③最後の連絡",
      "template": "messages/day10-followup.md",
      "audience": {
        "has_tag": "step_done",
        "not_tag": "bought_course"
      },
      "after_actions": [
        {
          "type": "add_tag",
          "tag": "nurture_active"
        }
      ],
      "follow_up_message": {
        "template": "messages/buttons/day10-course-button.json",
        "type": "flex"
      },
      "note": "本文の直後にボタン付きメッセージをもう1通送る（URLはボタンにのみ入れる）"
    }
  ],
  "post_scenario": {
    "note": "Day10 の後は nurture_active タグの人に週1配信。型と量産プロンプトは messages/weekly/README.md と prompts/weekly-broadcast-prompt.md。bought_course が付いた人は講座案内から除外する",
    "cadence": "週1回・水または木の20:00。4回のうち売り込みは1回だけ",
    "templates": "messages/weekly/"
  },
  "compliance": {
    "notes": [
      "効果の断定をしない。『縁が切れる』と約束しない。決めるのは本人という立場を全文面で崩さない",
      "ウソの締切・限定を付けない（景表法の有利誤認）。カウンセリングは対応枠が実際に有限なので『月◯名まで』は正当に使える",
      "全オファーURLは L Harness のトラッキングリンク経由で送る（どのDayで押されたかを計測）。noteの購入数と突き合わせる",
      "noteの禁止事項に触れないよう、占い的な効果の標榜・宗教的勧誘の表現は使わない。『人間関係の整理の手順』として書く"
    ]
  },
  "sales_platform": {
    "name": "note",
    "why": "特商法表記をnote側が担うため個人の住所・電話を公開せずに販売できる。Stripe・自前LPは使わない",
    "requirements": [
      "49,800円の記事を出すには noteプレミアム（有料記事の価格上限が上がる）が必要。上限・手数料は最新のnoteヘルプで確認",
      "有料記事の『購入者限定エリア』に、レポート本文／セッション予約導線／講座動画リンク＋週1相談のZoomを置く",
      "クリック計測はUTMではなく L Harness のトラッキングリンク（/t/）を使う（noteのアクセス解析はUTMを表示しない）"
    ]
  },
  "ai_kantei": {
    "spec": "ai-kantei/spec.md",
    "system_prompt": "ai-kantei/system-prompt.md",
    "reference_impl": "ai-kantei/worker-reference.ts",
    "model": "claude-opus-5",
    "passcodes": {
      "縁A-717": "a",
      "縁B-323": "b",
      "縁C-505": "c",
      "縁D-141": "d"
    },
    "limits": {
      "kantei_per_purchase": 1,
      "followup_per_purchase": 1
    },
    "danger_words": [
      "死にたい",
      "消えたい",
      "自殺",
      "殴られ",
      "暴力",
      "監禁",
      "脅され",
      "殺す",
      "ストーカー",
      "逃げられない"
    ],
    "passcode_matching": "trim → 全角英数を半角 → 大文字化 → ハイフン/アンダースコア/空白を除去 してから比較",
    "rotation": "3ヶ月に1回 passcodes の値を変え、note 記事の末尾も同時に更新する"
  },
  "line_buttons": {
    "why": "長文の中のURLはLINEでタップされにくい。本文とは別に、ボタンだけのメッセージをもう1通送る",
    "how": "messages/buttons/README.md を参照。エルメなら管理画面のボタンブロック、L Harness なら Flex Message JSON",
    "rule": "本文にURLは書かない。ボタンは1通につき1つ。ボタンの文字は20文字以内"
  }
}
