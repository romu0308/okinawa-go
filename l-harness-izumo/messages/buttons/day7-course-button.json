{
  "type": "flex",
  "altText": "出雲の縁切り実践講座",
  "contents": {
    "type": "bubble",
    "body": {
      "type": "box",
      "layout": "vertical",
      "spacing": "md",
      "paddingAll": "20px",
      "contents": [
        {
          "type": "text",
          "text": "出雲の縁切り実践講座",
          "weight": "bold",
          "size": "lg",
          "wrap": true,
          "color": "#333333"
        },
        {
          "type": "text",
          "text": "49,800円。動画講義＋週1グループ相談会＋質問LINE。まずは中身を読んでから決めてほしい。",
          "size": "sm",
          "wrap": true,
          "color": "#666666"
        }
      ]
    },
    "footer": {
      "type": "box",
      "layout": "vertical",
      "paddingAll": "16px",
      "paddingTop": "0px",
      "contents": [
        {
          "type": "button",
          "style": "primary",
          "height": "sm",
          "color": "#8B7355",
          "action": {
            "type": "uri",
            "label": "講座の詳細を見る",
            "uri": "{{course_url}}"
          }
        }
      ]
    }
