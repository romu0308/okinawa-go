---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LinePopup from '../components/LinePopup.astro';
import '../styles/global.css';

interface Props {
  class?: string;
  darkMode?: boolean;
}

const { class: className, darkMode = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="ja" transition:animate="none">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="format-detection" content="telephone=no" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="OKINAWA!GO!!" href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Noto+Sans+JP:wght@400;500&display=swap" rel="stylesheet" />

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-XXXXXXXXXX');
  </script>
  <meta name="google-site-verification" content="YOUR_VERIFICATION_CODE" />

  <ClientRouter />
  <slot name="head" />
</head>
<body class:list={[
  'min-h-screen flex flex-col',
  darkMode ? 'bg-[var(--dark-bg)] text-white' : 'bg-[var(--bg)] text-[var(--text)]',
  className,
]}>
  <Header darkMode={darkMode} />
  <main class="flex-1">
    <slot />
  </main>
  <Footer darkMode={darkMode} />
  <LinePopup />

  <script>
    import Lenis from 'lenis';
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    let lenis: Lenis | undefined;
    let rafId = 0;
    let contexts: gsap.Context[] = [];

    function destroyMotion() {
      cancelAnimationFrame(rafId);
      lenis?.destroy();
      lenis = undefined;
      contexts.forEach((context) => context.revert());
      contexts = [];
      ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
    }

    function initMotion() {
      destroyMotion();

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion) {
        lenis = new Lenis({
          duration: 1.1,
          easing: (time: number) => Math.min(1, 1.001 - Math.pow(2, -10 * time)),
          smoothWheel: true,
        });

        lenis.on('scroll', ScrollTrigger.update);
        const raf = (time: number) => {
          lenis?.raf(time);
          rafId = requestAnimationFrame(raf);
        };
        rafId = requestAnimationFrame(raf);
      }

      document.querySelectorAll<HTMLElement>('.reveal').forEach((element) => {
        if (reduceMotion) {
          element.style.opacity = '1';
          element.style.transform = 'none';
          return;
        }

        const context = gsap.context(() => {
          gsap.fromTo(
            element,
            { opacity: 0, y: 16 },
            {
              opacity: 1,
              y: 0,
              duration: 0.9,
              ease: 'power3.out',
              scrollTrigger: {
                trigger: element,
                start: 'top 88%',
                once: true,
              },
            },
          );
        }, element);
        contexts.push(context);
      });

      const heroMedia = document.querySelector<HTMLElement>('.hero-media');
      if (heroMedia && !reduceMotion) {
        const context = gsap.context(() => {
          gsap.to(heroMedia, {
            yPercent: 4,
            scale: 1.05,
            ease: 'none',
            scrollTrigger: {
              trigger: '#hero-container',
              start: 'top top',
              end: 'bottom top',
              scrub: true,
            },
          });
        });
        contexts.push(context);
      }

      ScrollTrigger.refresh();
    }

    initMotion();
    document.addEventListener('astro:page-load', initMotion);
    document.addEventListener('astro:before-swap', destroyMotion);
  </script>
</body>
</html>
