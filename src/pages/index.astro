---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEOHead from '../components/SEOHead.astro';
import HeroWebGL from '../components/HeroWebGL.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const sortedArticles = allArticles.sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
);

const featuredArticle = sortedArticles.find((article) => article.data.featured) ?? sortedArticles[0];
const latestArticles = sortedArticles.filter((article) => article.id !== featuredArticle?.id).slice(0, 5);
const marqueeItems = ['#沖縄旅行', '#地元民', '#沖縄そば', '#穴場', '#2泊3日', '#北谷', '#恩納村', '#グルメ'];

const categoryLabels: Record<string, string> = {
  'model-course': 'Model Course',
  'area-guide': 'Area Guide',
  food: 'Food',
  activity: 'Activity',
  tips: 'Tips',
  seasonal: 'Seasonal',
};

const formatDate = (dateStr: string) => {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
};
---

<BaseLayout>
  <SEOHead
    slot="head"
    title="OKINAWA!GO!!"
    description="住んでるからこそわかる沖縄がある。沖縄在住フリーランスが、ガイドブックに載らない沖縄の楽しみ方を発信。"
    ogType="website"
  />

  <HeroWebGL />

  <div class="overflow-hidden border-y border-[var(--border)] py-[11px]" style="border-width: 0.5px;">
    <div class="marquee-track flex w-max whitespace-nowrap" aria-hidden="true">
      {[...marqueeItems, ...marqueeItems].map((tag) => (
        <span class="inline-block px-[18px] font-['Inter'] text-[11px] text-[#aaa]">{tag}</span>
      ))}
      {[...marqueeItems, ...marqueeItems].map((tag) => (
        <span class="inline-block px-[18px] font-['Inter'] text-[11px] text-[#aaa]">{tag}</span>
      ))}
    </div>
  </div>

  {featuredArticle && (
    <section class="mx-auto max-w-[1200px] px-5 pb-12 pt-20 md:px-10 md:pb-16 md:pt-28">
      <div class="reveal mb-10">
        <span class="label-text mb-3 block">Pick Up</span>
        <h2 class="text-[22px] font-medium leading-[1.3] tracking-[-0.02em] text-[var(--text)] md:text-[28px]">注目の記事</h2>
      </div>

      <a href={`/articles/${featuredArticle.id}/`} class="featured-card group block no-underline reveal" transition:name={`article-${featuredArticle.id}`}>
        <article class="relative h-[440px] overflow-hidden rounded-[6px] md:h-[500px]">
          <img
            src={featuredArticle.data.thumbnail}
            alt={featuredArticle.data.thumbnailAlt}
            class="h-full w-full object-cover transition-transform duration-[600ms] ease-out group-hover:scale-[1.03]"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
          <span class="absolute left-5 top-5 font-['Inter'] text-[9px] tracking-[0.12em] text-white/50 md:left-7 md:top-7">No.001</span>
          <div class="absolute inset-x-0 bottom-0 p-5 md:p-8">
            <div class="mb-3 flex items-center gap-3">
              <span class="font-['Inter'] text-[9px] uppercase tracking-[0.12em] text-white/50">
                {categoryLabels[featuredArticle.data.category] || featuredArticle.data.category}
              </span>
              <span class="font-['Inter'] text-[9px] tracking-[0.12em] text-white/40">
                {formatDate(featuredArticle.data.publishedAt)}
              </span>
            </div>
            <h3 class="max-w-[760px] text-[24px] font-medium leading-[1.45] text-white transition-opacity duration-300 group-hover:opacity-70 md:text-[32px]">
              {featuredArticle.data.title}
            </h3>
          </div>
        </article>
      </a>
    </section>
  )}

  <section class="mx-auto max-w-[1200px] px-5 pb-20 pt-12 md:px-10 md:pb-28 md:pt-16">
    <div class="reveal mb-10 flex items-end justify-between">
      <div>
        <span class="label-text mb-3 block">Articles</span>
        <h2 class="text-[22px] font-medium leading-[1.3] tracking-[-0.02em] text-[var(--text)] md:text-[28px]">記事一覧</h2>
      </div>
      <a href="/articles/" class="border-b border-[#ccc] pb-1 font-['Inter'] text-[10px] text-[#aaa] no-underline transition-colors duration-300 hover:text-[var(--text)]" style="border-width: 0.5px;">
        View all
      </a>
    </div>

    <div class="reveal">
      {latestArticles.map((article, index) => (
        <ArticleCard
          slug={article.id}
          title={article.data.title}
          description={article.data.description}
          publishedAt={article.data.publishedAt}
          category={article.data.category}
          thumbnail={article.data.thumbnail}
          thumbnailAlt={article.data.thumbnailAlt}
          number={index + 2}
        />
      ))}
    </div>
  </section>

  <section class="bg-[var(--dark-bg)] px-5 py-16 md:px-10 md:py-[100px]">
    <div class="reveal mx-auto max-w-[1200px]">
      <span class="mb-6 block font-['Inter'] text-[9px] uppercase tracking-[0.25em] text-white/25">Shindan</span>
      <h2 class="mb-4 text-[32px] font-medium leading-[1.2] tracking-[-0.02em] text-white md:text-[40px]">あなたの沖縄旅行タイプは？</h2>
      <p class="mb-10 max-w-[400px] text-[11px] leading-[1.7] text-white/35">5つの質問に答えるだけで、あなたに合う沖縄旅行のスタイルとおすすめエリアがわかります。</p>
      <a href="/shindan/" class="group inline-flex items-center gap-4 no-underline">
        <span class="font-['Inter'] text-[13px] tracking-[0.04em] text-white transition-opacity duration-300 group-hover:opacity-60">Start</span>
        <span class="flex h-8 w-8 items-center justify-center rounded-full border border-white/20 transition-opacity duration-300 group-hover:opacity-60" style="border-width: 0.5px;">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 6H9.5M9.5 6L6.5 3M9.5 6L6.5 9" stroke="white" stroke-width="0.8"/></svg>
        </span>
      </a>
    </div>
  </section>

  <section class="border-b border-[var(--border)] px-5 py-16 md:px-10 md:py-24" style="border-width: 0.5px;">
    <div class="reveal mx-auto max-w-[1200px]">
      <span class="label-text mb-6 block">AI Trip Planner</span>
      <h2 class="mb-4 text-[22px] font-medium leading-[1.3] tracking-[-0.02em] text-[var(--text)] md:text-[28px]">
        沖縄在住者AIが、<br class="md:hidden" />あなたの旅をプランニング。
      </h2>
      <p class="mt-6 font-['Inter'] text-[10px] tracking-[0.12em] text-[var(--text-muted)]">Coming Soon</p>
    </div>
  </section>
</BaseLayout>
