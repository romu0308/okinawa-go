---
const imageUrl = 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=1400&q=85';
---

<section class="hero-webgl relative w-full overflow-hidden" id="hero-container" aria-labelledby="hero-copy">
  <div id="hero-media-layer" class="absolute inset-0 hero-media">
    <img
      src={imageUrl}
      alt="沖縄の青い海と白い砂浜"
      class="absolute inset-0 h-full w-full object-cover"
      id="hero-fallback-img"
      loading="eager"
      fetchpriority="high"
    />
    <canvas
      id="hero-canvas"
      class="absolute inset-0 h-full w-full"
      style="opacity: 0; transition: opacity 0.6s ease;"
      aria-hidden="true"
    ></canvas>
  </div>

  <div
    class="absolute inset-0 pointer-events-none"
    style="background: linear-gradient(180deg, rgba(0,0,0,0.08) 0%, rgba(0,0,0,0.02) 40%, rgba(255,255,255,0.6) 85%, #fff 100%);"
  ></div>

  <div class="absolute inset-0 px-5 py-6 md:px-10 md:py-10 pointer-events-none">
    <span class="absolute left-5 top-6 md:left-10 md:top-10 font-['Inter'] text-[9px] tracking-[0.25em] uppercase text-white/50">
      Okinawa Local Guide
    </span>

    <h1
      id="hero-copy"
      class="absolute left-1/2 top-[39%] w-[calc(100%-40px)] -translate-x-1/2 -translate-y-1/2 text-center text-[38px] md:text-[56px] font-medium leading-[1.2] tracking-[-0.03em] text-white"
      style="text-shadow: 0 1px 30px rgba(0,0,0,0.1);"
    >
      <span class="hero-copy-line block md:hidden">住んでる</span>
      <span class="hero-copy-line block md:hidden">からこそ、</span>
      <span class="hero-copy-line block md:hidden">わかる</span>
      <span class="hero-copy-line block md:hidden">沖縄がある。</span>
      <span class="hero-copy-line hidden md:block">住んでるからこそ、</span>
      <span class="hero-copy-line hidden md:block">わかる沖縄がある。</span>
    </h1>

    <div class="absolute bottom-7 left-5 md:bottom-10 md:left-10 flex flex-col items-center gap-2">
      <span class="font-['Inter'] text-[9px] tracking-[0.2em] uppercase text-[#aaa] [writing-mode:vertical-lr]">Scroll</span>
      <span class="block h-6 w-px bg-[#aaa]"></span>
    </div>

    <p class="absolute bottom-7 right-5 md:bottom-10 md:right-10 max-w-[210px] text-right text-[11px] leading-[1.7] text-[#777]">
      ガイドブックに載らない沖縄を、<br />在住者の目線で。
    </p>
  </div>
</section>

<style>
  .hero-webgl {
    height: 560px;
  }

  @media (min-width: 768px) {
    .hero-webgl {
      height: 90vh;
      min-height: 640px;
      max-height: 980px;
    }
  }
</style>

<script>
  import * as THREE from 'three';

  type HeroCleanup = () => void;
  const cleanupMap = new WeakMap<HTMLElement, HeroCleanup>();

  function initHeroWebGL() {
    const container = document.getElementById('hero-container');
    const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
    const fallbackImg = document.getElementById('hero-fallback-img') as HTMLImageElement | null;
    if (!container || !canvas || !fallbackImg || cleanupMap.has(container)) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile = window.matchMedia('(max-width: 767px)').matches;

    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, antialias: false, alpha: true, powerPreference: 'high-performance' });
    } catch {
      return;
    }

    renderer.setPixelRatio(Math.min(window.devicePixelRatio, isMobile ? 1.25 : 1.75));
    renderer.setSize(container.clientWidth, container.clientHeight, false);

    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0.1, 10);
    camera.position.z = 1;

    const uniforms = {
      uTexture: { value: new THREE.Texture() },
      uTime: { value: 0 },
      uMouse: { value: new THREE.Vector2(0.5, 0.5) },
      uMouseIntensity: { value: isMobile ? 0.35 : 0 },
      uResolution: { value: new THREE.Vector2(container.clientWidth, container.clientHeight) },
      uImageResolution: { value: new THREE.Vector2(1400, 933) },
    };

    const material = new THREE.ShaderMaterial({
      uniforms,
      vertexShader: `
        varying vec2 vUv;
        void main() {
          vUv = uv;
          gl_Position = vec4(position, 1.0);
        }
      `,
      fragmentShader: `
        precision mediump float;
        uniform sampler2D uTexture;
        uniform float uTime;
        uniform vec2 uMouse;
        uniform float uMouseIntensity;
        uniform vec2 uResolution;
        uniform vec2 uImageResolution;
        varying vec2 vUv;

        vec2 coverUv(vec2 uv) {
          float viewportAspect = uResolution.x / uResolution.y;
          float imageAspect = uImageResolution.x / uImageResolution.y;
          vec2 scale = vec2(1.0);
          if (imageAspect > viewportAspect) {
            scale.x = viewportAspect / imageAspect;
          } else {
            scale.y = imageAspect / viewportAspect;
          }
          return (uv - 0.5) * scale + 0.5;
        }

        void main() {
          vec2 uv = coverUv(vUv);
          float dist = distance(vUv, uMouse);
          float ripple = sin(dist * 24.0 - uTime * 2.2) * exp(-dist * 6.0) * 0.006 * uMouseIntensity;
          float ambient = sin(vUv.x * 4.0 + uTime * 0.35) * cos(vUv.y * 3.0 + uTime * 0.25) * 0.0018;
          uv += vec2(ripple + ambient);
          vec4 color = texture2D(uTexture, uv);
          float grain = fract(sin(dot(vUv + uTime * 0.0005, vec2(12.9898, 78.233))) * 43758.5453);
          color.rgb += (grain - 0.5) * 0.008;
          gl_FragColor = color;
        }
      `,
    });

    const geometry = new THREE.PlaneGeometry(2, 2);
    const mesh = new THREE.Mesh(geometry, material);
    scene.add(mesh);

    let frame = 0;
    let running = true;
    let visible = true;
    const clock = new THREE.Clock();
    const targetMouse = new THREE.Vector2(0.5, 0.5);

    const render = () => {
      if (!running) return;
      frame = requestAnimationFrame(render);
      if (!visible || reduceMotion) return;

      const elapsed = clock.getElapsedTime();
      uniforms.uTime.value = elapsed;
      if (isMobile) {
        uniforms.uMouse.value.set(
          0.5 + Math.sin(elapsed * 0.25) * 0.18,
          0.5 + Math.cos(elapsed * 0.3) * 0.12,
        );
      } else {
        uniforms.uMouse.value.lerp(targetMouse, 0.06);
      }
      renderer.render(scene, camera);
    };

    const textureLoader = new THREE.TextureLoader();
    textureLoader.setCrossOrigin('anonymous');
    textureLoader.load(
      fallbackImg.currentSrc || fallbackImg.src,
      (texture) => {
        texture.minFilter = THREE.LinearFilter;
        texture.magFilter = THREE.LinearFilter;
        texture.colorSpace = THREE.SRGBColorSpace;
        uniforms.uTexture.value = texture;
        const image = texture.image as HTMLImageElement;
        uniforms.uImageResolution.value.set(image.naturalWidth || image.width, image.naturalHeight || image.height);
        renderer.render(scene, camera);
        canvas.style.opacity = '1';
        fallbackImg.style.opacity = '0';
        if (!reduceMotion) render();
      },
      undefined,
      () => {
        canvas.style.display = 'none';
      },
    );

    const handlePointerMove = (event: PointerEvent) => {
      if (isMobile) return;
      const rect = container.getBoundingClientRect();
      targetMouse.set(
        (event.clientX - rect.left) / rect.width,
        1 - (event.clientY - rect.top) / rect.height,
      );
      uniforms.uMouseIntensity.value = 1;
    };

    const handlePointerLeave = () => {
      if (!isMobile) uniforms.uMouseIntensity.value = 0;
    };

    const handleResize = () => {
      const width = container.clientWidth;
      const height = container.clientHeight;
      renderer.setSize(width, height, false);
      uniforms.uResolution.value.set(width, height);
      renderer.render(scene, camera);
    };

    const visibilityObserver = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
    });
    visibilityObserver.observe(container);

    container.addEventListener('pointermove', handlePointerMove, { passive: true });
    container.addEventListener('pointerleave', handlePointerLeave, { passive: true });
    window.addEventListener('resize', handleResize, { passive: true });

    const cleanup = () => {
      running = false;
      cancelAnimationFrame(frame);
      visibilityObserver.disconnect();
      container.removeEventListener('pointermove', handlePointerMove);
      container.removeEventListener('pointerleave', handlePointerLeave);
      window.removeEventListener('resize', handleResize);
      geometry.dispose();
      material.dispose();
      const texture = uniforms.uTexture.value;
      if (texture instanceof THREE.Texture) texture.dispose();
      renderer.dispose();
      cleanupMap.delete(container);
    };

    cleanupMap.set(container, cleanup);
  }

  function animateHeroCopy() {
    const lines = document.querySelectorAll<HTMLElement>('.hero-copy-line');
    lines.forEach((line, index) => {
      line.style.opacity = '0';
      line.style.transform = 'translateY(16px)';
      line.animate(
        [
          { opacity: 0, transform: 'translateY(16px)' },
          { opacity: 1, transform: 'translateY(0)' },
        ],
        { duration: 800, delay: 180 + index * 150, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'forwards' },
      );
    });
  }

  function initHero() {
    initHeroWebGL();
    animateHeroCopy();
  }

  initHero();
  document.addEventListener('astro:page-load', initHero);
</script>
