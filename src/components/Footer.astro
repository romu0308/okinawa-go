---
interface Props { darkMode?: boolean; }
const { darkMode = false } = Astro.props;
---

<footer class:list={['w-full', darkMode ? 'border-t border-white/10' : 'border-t border-[var(--border)]']} style="border-width: 0.5px;">
  <div class="flex items-center justify-between px-5 py-5 md:px-10">
    <a href="/" class:list={['font-[Inter] text-[9px] uppercase tracking-[0.15em] no-underline transition-opacity duration-300 hover:opacity-60', darkMode ? 'text-white/30' : 'text-[var(--text-tertiary)]']}>
      OKINAWA!GO!!
    </a>
    <a href="https://x.com/KOUMEI_GO" target="_blank" rel="noopener noreferrer" class:list={['font-[Inter] text-[9px] tracking-[0.08em] no-underline transition-opacity duration-300 hover:opacity-60', darkMode ? 'text-white/20' : 'text-[var(--text-muted)]']}>
      @KOUMEI_GO
    </a>
  </div>
</footer>
